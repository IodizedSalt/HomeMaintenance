            "recipe_ingredients": [
                "250 g brown or green lentils",
                "4 onions (about 700 g before peeling)",
                "3 tbsp wheat flour",
                "2½ dl sunflower oil",
                "2 tsp cumin seeds",
                "1½ tbsp coriander seeds",
                "200 g basmati rice",
                "2 tbsp olive oil",
                "½ tsp ground turmeric",
                "1½ tsp ground allspice",
                "1½ tsp ground cinnamon",
                "1 tsp sugar",
                "3½ dl water",
                "Salt and black pepper"
            ],
            "ingredients_list": [
                "lentils",
                "onion",
                "flour",
                "sunflower_oil",
