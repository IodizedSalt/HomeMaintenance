<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= recipe.title %> - Vedersøvej 26</title>

    <link href="/app/css/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link href="/app/css/custom_css.css" rel="stylesheet">
</head>

<body>

    <a href="/dinner">
        <img src="/app/img/misc/android-chrome-512x512.png"
             style="max-width: 50px; margin: 2em;"
             alt="Home"
             class="home-icon">
    </a>

    <div class="container my-4">

        <h2 class="mb-4"><%= recipeTitle %></h2>

        <% if (recipe.image) { %>
            <img src="<%= recipe.image %>"
                 class="img-fluid rounded mb-4 w-100"
                 alt="<%= recipe.title %>"
                 style="max-height: 450px; object-fit: cover;">
        <% } %>

        <div class="row">

            <div class="col-md-4 mb-4">
                <h5>Ingredients</h5>

                <% if (recipe.recipe_ingredients && recipe.recipe_ingredients.length) { %>
                    <ul>
                        <% recipe.recipe_ingredients.forEach(function(ingredient) { %>
                            <li><%= ingredient %></li>
                        <% }); %>
                    </ul>
                <% } else { %>
                    <p>No ingredients available.</p>
                <% } %>
            </div>

            <div class="col-md-8">
                <h5>Instructions</h5>

                <% if (recipe.recipe_steps) { %>
                    <ol>
                        <% Object.keys(recipe.recipe_steps)
                            .sort(function(a, b) { return Number(a) - Number(b); })
                            .forEach(function(step) { %>
                                <li class="mb-3">
                                    <%= recipe.recipe_steps[step] %>
                                </li>
                        <% }); %>
                    </ol>
                <% } else { %>
                    <p>No instructions available.</p>
                <% } %>
            </div>

        </div>
    </div>

</body>
</html>